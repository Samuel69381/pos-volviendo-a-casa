# Copia este archivo como .env.development y .env.production y llena los valores.
# Están en Supabase -> Project Settings -> API y -> General.

# Proyecto
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://TU_REF.supabase.co

# Clave pública: la usa el frontend; segura solo si RLS está activo
SUPABASE_ANON_KEY=

# Solo para la CLI en tu computador. NUNCA en el frontend
SUPABASE_DB_PASSWORD=
